[Unit]
Description=Time v4 private devnet operator bundle (remote fenced signer required)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/time-v4
EnvironmentFile=/etc/time-v4/operator.env
ExecStartPre=/usr/bin/node /opt/time-v4/context/deploy/build.mjs check-env
ExecStart=/usr/bin/docker compose --file /opt/time-v4/context/deploy/compose.yaml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose --file /opt/time-v4/context/deploy/compose.yaml down --timeout 60
Restart=no
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/run/docker.sock

[Install]
WantedBy=multi-user.target
